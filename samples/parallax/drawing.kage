//kage:unit pixels

// The picture model drawing what a layer hid, as the window shows it: where the layer was
// (source 1, the mask, over a half) the picture is noise that gets finer and calmer at each step
// of the drawing done (Done 0 to 1), under a light along its edge; elsewhere the picture
// (source 0) as it is. Nothing in it moves but with Done: the window shows the work, not an
// animation of it.

package main

// Done is how much of the drawing is done.
var Done float

func hash(p vec2) float {
	return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453)
}

func Fragment(dst vec4, src vec2, color vec4) vec4 {
	pic := imageSrc0At(src)
	m := imageSrc1At(src).r
	if m < 0.02 {
		return pic
	}
	// noise in blocks that get finer as the drawing goes, another at each hundredth done
	cell := mix(14.0, 2.0, Done)
	q := floor(src/cell) * cell
	t := floor(Done * 100)
	n := vec3(hash(q+t), hash(q+t+17.0), hash(q+t+41.0))
	// calmer and greyer as it goes, over a dark ground
	amp := mix(0.6, 0.2, Done)
	grey := (n.r + n.g + n.b) / 3
	c := mix(vec3(grey), n, 0.3) * amp
	c += vec3(0.04, 0.05, 0.07)
	// a light along the edge of the part (where the mask is between)
	edge := 1 - abs(m*2-1)
	c += vec3(0.25, 0.45, 0.7) * edge
	return vec4(mix(pic.rgb, c, m), 1)
}
